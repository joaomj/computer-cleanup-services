<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.macos-cleanup-service</string>
    <key>ProgramArguments</key>
    <array>
        <string>LIBEXEC_DIR_PLACEHOLDER/python3</string>
        <string>LIBEXEC_DIR_PLACEHOLDER/maintenance.py</string>
        <string>--updates-only</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:LAUNCHD_PATH_EXTRA_PLACEHOLDER</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>STATE_DIR_PLACEHOLDER/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>STATE_DIR_PLACEHOLDER/launchd-stderr.log</string>
</dict>
</plist>
