[Unit]
Description=Daily upgrades and automatic low-risk cleanup

[Service]
Type=oneshot
ExecStart=%h/.local/libexec/linux-cleanup-service/python3 %h/.local/libexec/linux-cleanup-service/maintenance.py
Environment="XDG_CONFIG_HOME=CONFIG_ROOT_PLACEHOLDER"
TimeoutStartSec=30min
PrivateTmp=false
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
